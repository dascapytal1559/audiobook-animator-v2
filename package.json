{
  "name": "animator-v2",
  "version": "0.1.0",
  "private": true,
  "description": "An audiobook-to-movie pipeline.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm --filter @animator/domain build && tsc --project tsconfig.json",
    "typecheck": "pnpm --filter @animator/domain build && tsc --project tsconfig.json --noEmit",
    "test": "pnpm run build && node --enable-source-maps --test 'dist/**/*.test.js'",
    "check": "pnpm --filter @animator/domain test && pnpm run test && pnpm --filter editor test && pnpm --filter editor typecheck",
    "cli": "node --enable-source-maps dist/cli.js"
  },
  "dependencies": {
    "@animator/domain": "workspace:*",
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
