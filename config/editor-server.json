{
  "schemaVersion": 1,
  "storiesDirectory": "../data/stories",
  "visualTimelineConfigPath": "visual-timeline.json",
  "ffmpegPath": "ffmpeg",
  "peaks": {
    "samplesPerBucket": 1024,
    "maxCacheBytes": 16777216
  },
  "speech": {
    "frameMs": 10,
    "thresholdDbfs": -50,
    "minSilenceMs": 150,
    "minSpeechMs": 50
  },
  "alignment": {
    "leadMs": 150,
    "boundaryPauseMs": 300
  },
  "watch": {
    "debounceMs": 200
  },
  "limits": {
    "maxUploadBytes": 52428800,
    "requestTimeoutMs": 30000
  },
  "chunking": {
    "pauseBreakMs": 600,
    "minSentenceBreakMs": 150
  }
}
