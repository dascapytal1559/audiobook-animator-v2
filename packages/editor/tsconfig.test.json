{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "test-dist",
    "types": [
      "vite/client",
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src/snap.ts",
