    "src/rows.ts",
    "src/rows.test.ts",
    "src/selection.ts",
    "src/selection.test.ts",
    "src/timing.ts",
    "src/timing.test.ts",
    "src/api.ts",
    "src/view.ts",
    "src/view.test.ts"
  ]
}
